# Public browser configuration only. Copy this file to .env.
# Replace both placeholders with your Supabase project URL and publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Optional public destinations. Empty/invalid values render no contact link.
# Omitting the phone variable preserves the existing local host-dialog number.
# VITE_HOST_CONTACT_NUMBER=
# Set only the actual approved HTTPS F1 Forge destination; blank disables links.
VITE_F1FORGE_URL=
